# Or leave unset for automatic detection.
BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender
# auto | cpu | gpu. auto falls back to CPU; gpu fails if no compatible device exists.
CYCLES_DEVICE=auto
# Optional installed Chrome for headless exports (otherwise Playwright Chromium).
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
